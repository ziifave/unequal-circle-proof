def oneCellCoeff : Rat := (999999999999 : Rat) / 1000000000000

def oneCellSum : Rat :=
  (List.range 21).foldl (fun total pair =>
    let w0 := if (oneCellWeights[2 * pair]!) > 0 then oneCellCoeff else 0
    let w1 := if (oneCellWeights[2 * pair + 1]!) > 0 then oneCellCoeff else 0
    total + (w0 + w1) * oneCellAngles[pair]!) 0

def oneCellDual (gap : Nat) : Rat :=
  (List.range 42).foldl (fun total row =>
    if (oneCellWeights[row]!) > 0 &&
       ((oneCellRows[row]! >>> gap) % 2 == 1)
    then total + oneCellCoeff else total) 0

example : (List.range 7).all (fun gap => oneCellDual gap ≤ 1) = true := by
  native_decide

