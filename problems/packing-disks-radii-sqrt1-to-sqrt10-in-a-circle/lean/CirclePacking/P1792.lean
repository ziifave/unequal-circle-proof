def p1792Coefficient (j : Nat) : ℤ :=
  p1792PrimitiveCoefficients.get! j

def p1792PrimitivePolynomial : Polynomial ℚ :=
  ∑ j in Finset.range 1793,
    Polynomial.C (p1792Coefficient j : ℚ) * Polynomial.X ^ j

def p1792PrimitiveEval (x : ℝ) : ℝ :=
  ∑ j in Finset.range 1793,
    (p1792Coefficient j : ℝ) * x ^ j

theorem eval_p1792PrimitivePolynomial (x : ℝ) :
    (p1792PrimitivePolynomial.map (algebraMap ℚ ℝ)).eval x =
      p1792PrimitiveEval x := by
  simp [p1792PrimitivePolynomial, p1792PrimitiveEval,
    Polynomial.eval₂_at, mul_assoc, mul_left_comm, mul_comm]

theorem p1792_table_shape :
    p1792PrimitiveCoefficients.length = 1793 := by
  native_decide

/- The missing bridge is deliberately explicit: the integer table is data,
   while identifying R0 as its root requires the exact elimination theorem. -/
def IsP1792Root (x : ℝ) : Prop :=
  p1792PrimitiveEval x = 0

theorem isP1792Root_iff_polynomial (x : ℝ) :
    IsP1792Root x ↔
      (p1792PrimitivePolynomial.map (algebraMap ℚ ℝ)).eval x = 0 := by
  simp [IsP1792Root, eval_p1792PrimitivePolynomial]

/- Exact elimination bridge still to be replayed from the contact identities.
   Once supplied, it identifies the closure root with the algebraic root; an
   overlap of numerical intervals alone is deliberately not used for this. -/
structure ContactEliminationBridge where
  g112_of_closure : ∀ R : ℝ,
    hennenbergClosureResidual R = 0 → IsG112Root R
  p1792_of_g112 : ∀ R : ℝ,
    IsG112Root R → IsP1792Root R

theorem p1792_root_of_elimination_bridge
    {cert : RootIsolationCertificate hennenbergClosureResidual}
    (bridge : ContactEliminationBridge) :
    IsP1792Root (R0 cert) := by
  apply bridge.p1792_of_g112
  apply bridge.g112_of_closure
  exact cert.root_spec.2

/- This is the concrete import boundary for the supplied P1792 certificate.
   The root and irreducibility fields are intentionally not axiomatized. -/
structure P1792R0Certificate
    (cert : RootIsolationCertificate hennenbergClosureResidual) where
  root : IsP1792Root (R0 cert)
  nonzero : p1792PrimitivePolynomial ≠ 0
  degree : p1792PrimitivePolynomial.natDegree = 1792
  irreducible : Irreducible p1792PrimitivePolynomial
  g112_root : G112Compatible cert

def P1792R0Certificate.ofEliminationBridge
    {cert : RootIsolationCertificate hennenbergClosureResidual}
    (bridge : ContactEliminationBridge)
    (nonzero : p1792PrimitivePolynomial ≠ 0)
    (degree : p1792PrimitivePolynomial.natDegree = 1792)
    (irreducible : Irreducible p1792PrimitivePolynomial) :
    P1792R0Certificate cert :=
  { root := p1792_root_of_elimination_bridge bridge
    nonzero := nonzero
    degree := degree
    irreducible := irreducible
    g112_root := bridge.g112_of_closure (R0 cert) cert.root_spec.2 }

theorem p1792_certificate_is_algebraic
    {cert : RootIsolationCertificate hennenbergClosureResidual}
    (h : P1792R0Certificate cert) :
    IsAlgebraic ℚ (R0 cert) := by
  refine ⟨p1792PrimitivePolynomial, h.nonzero, ?_⟩
  rw [Polynomial.aeval_def]
  exact (isP1792Root_iff_polynomial (R0 cert)).mp h.root

def P1792R0Certificate.toDegree1792
    {cert : RootIsolationCertificate hennenbergClosureResidual}
    (h : P1792R0Certificate cert) : Degree1792R0Certificate cert :=
  { toAlgebraicR0Certificate :=
      { qPolynomial := p1792PrimitivePolynomial
        qPolynomial_ne_zero := h.nonzero
        qPolynomial_root := by
          rw [Polynomial.aeval_def]
          exact (isP1792Root_iff_polynomial (R0 cert)).mp h.root
        g112_root := h.g112_root }
    qPolynomial_degree := h.degree
    qPolynomial_irreducible := h.irreducible }

end CirclePacking
